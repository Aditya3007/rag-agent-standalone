# Required: Groq API key(s) — used for generation and query transform in
# ALL 4 domains, the LLM domain router, and the shared TRACe/RGB
# evaluators. No other model server (e.g. Ollama) is needed. Comma-separate
# multiple keys for rotation.
GROQ_API_KEY=your_groq_api_key_here

# Optional: HuggingFace token, only needed if galileo-ai/ragbench ever
# requires authentication to download.
HF_TOKEN=

# Optional: point the agent at a standalone retrieval API (api/main.py)
# instead of building the full chunk/embed/index pipeline in-process.
# Leave unset to keep the default fully in-process behavior. See
# README.md "Retrieval API".
RAG_RETRIEVAL_API_URL=

# Optional: config dir the retrieval API itself loads domains.yaml/
# <domain>.yaml from. Defaults to rag-agent-standalone/configs.
RAG_CONFIG_DIR=

# Optional: port the retrieval API listens on when run via
# `python -m api.main` (ignored when run via `uvicorn api.main:app`).
RAG_API_PORT=8000
