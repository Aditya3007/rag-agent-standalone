{
  "version": 2,
  "builds": [
    {
      "src": "api/vercel_agent.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "maxLambdaSize": "50mb",
        "installCommand": "pip install pyyaml groq openai python-dotenv requests"
      }
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/api/vercel_agent.py/handler"
    },
    {
      "src": "/ask",
      "dest": "/api/vercel_agent.py/handler"
    }
  ]
}
